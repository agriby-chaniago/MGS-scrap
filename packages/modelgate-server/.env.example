# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=modelgate
POSTGRES_USER=modelgate
POSTGRES_PASSWORD=modelgate_secret

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=modelgate-datasets
MINIO_SECURE=false

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Auth
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=60

# F9 (ROADMAP.md Fase 5): off by default — single-user self-hosted mode,
# every request attributed to a fixed "local" user, no login required.
# Set to "true" for multi-user mode (real JWT/API-key auth enforced).
AUTH_REQUIRED=false
